# Signs and checks every licence key. Generate with: openssl rand -hex 32
# Changing this invalidates every key you have already sold — set it once.
KEY_SECRET=

# Enables POST /api/admin/mint. Leave blank to keep that endpoint switched off
# and mint keys from the command line instead (npm run keys).
ADMIN_TOKEN=

# How long an activated browser stays unlocked before it re-checks. Default 90.
TOKEN_DAYS=90

# Comma-separated keys to switch off, e.g. after a refund or a chargeback.
REVOKED_KEYS=

# Only needed if the page is served from a different domain than this API.
# ALLOWED_ORIGINS=https://app.marketingagency.com.sg

PORT=3000
